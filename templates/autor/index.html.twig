{% extends 'base.html.twig' %}

{% block title %}Autores | MyLibrary{% endblock %}

{% block body %}
    <main class="auth-portal app-portal authors-portal">
        <section class="app-shell authors-shell">
            <div class="app-welcome authors-welcome">
                <h1>Autores</h1>
            </div>

            <div class="app-content-panel authors-panel">
                <div class="app-content-panel__header authors-header-row">
                    <div class="app-panel-title-wrap">
                        <span class="auth-lock" aria-hidden="true">👤</span>
                        <div>
                            <h2>Gerenciamento de autores</h2>
                            <p>Cadastre, edite e mantenha os autores do catálogo.</p>
                        </div>
                    </div>
                    <a class="auth-submit app-submit" href="{{ path('app_autor_novo') }}">Novo autor</a>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="flash flash-success" role="status">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="flash flash-error" role="alert">{{ message }}</div>
                {% endfor %}

                {% if autores is empty %}
                    <section class="empty-state authors-empty">
                        <h3>Nenhum autor cadastrado</h3>
                        <p>Cadastre o primeiro autor para começar a organizar o acervo.</p>
                    </section>
                {% else %}
                    <section class="table-card authors-table-card">
                        <table>
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Nome</th>
                                    <th class="actions-column">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for autor in autores %}
                                <tr>
                                    <td>{{ autor.codigo }}</td>
                                    <td>{{ autor.nome }}</td>
                                    <td class="table-actions">
                                        <a class="link-button" href="{{ path('app_autor_editar', {codigo: autor.codigo}) }}">Editar</a>
                                        <form method="post" action="{{ path('app_autor_excluir', {codigo: autor.codigo}) }}" onsubmit="return confirm('Excluir o autor {{ autor.nome|e('js') }}?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('excluir_autor_' ~ autor.codigo) }}">
                                            <button class="link-button danger" type="submit">Excluir</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </section>
                {% endif %}
            </div>
        </section>
    </main>
{% endblock %}
