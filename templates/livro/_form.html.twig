{{ form_start(form, {attr: {class: 'catalog-form author-form livro-form'}}) }}
    {{ form_row(form.titulo) }}
    {{ form_row(form.editora) }}
    <div class="form-grid">
        {{ form_row(form.edicao) }}
        {{ form_row(form.anoPublicacao) }}
    </div>
    {{ form_row(form.valor) }}
    {{ form_row(form.autores) }}
    {{ form_row(form.assuntos) }}
    <div class="form-actions author-form-actions">
        <a class="link-button" href="{{ path('app_livro_index') }}">Cancelar</a>
        <button type="submit">Salvar</button>
    </div>
{{ form_end(form) }}
