{% extends 'base.html.twig' %}

{% block title %}Livros | MyLibrary{% endblock %}

{% block body %}
    <main class="auth-portal app-portal authors-portal">
        <section class="app-shell authors-shell">
            <div class="app-welcome authors-welcome">
                <h1>Livros</h1>
            </div>

            <div class="app-content-panel authors-panel">
                <div class="app-content-panel__header authors-header-row">
                    <div class="app-panel-title-wrap">
                        <span class="auth-lock" aria-hidden="true">📖</span>
                        <div>
                            <h2>Gerenciamento de livros</h2>
                            <p>Gerencie o acervo e seus autores e assuntos.</p>
                        </div>
                    </div>
                    <a class="auth-submit app-submit" href="{{ path('app_livro_novo') }}">Novo livro</a>
                </div>

                {% for message in app.flashes('success') %}<div class="flash flash-success" role="status">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="flash flash-error" role="alert">{{ message }}</div>{% endfor %}

                {% if livros is empty %}
                    <section class="empty-state authors-empty">
                        <h3>Nenhum livro cadastrado</h3>
                        <p>Cadastre um livro para iniciar o acervo.</p>
                    </section>
                {% else %}
                    <section class="table-card authors-table-card table-scroll table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Título</th>
                                    <th>Autor(es)</th>
                                    <th>Assuntos</th>
                                    <th>Valor</th>
                                    <th class="actions-column">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for livro in livros %}
                                <tr>
                                    <td><a href="{{ path('app_livro_exibir', {codigo: livro.codigo}) }}">{{ livro.titulo }}</a></td>
                                    <td>{{ livro.autores|map(autor => autor.nome)|join(', ') }}</td>
                                    <td>{{ livro.assuntos|map(assunto => assunto.descricao)|join(', ') }}</td>
                                    <td>R$ {{ (livro.valor / 100)|number_format(2, ',', '.') }}</td>
                                    <td class="table-actions">
                                        <a class="link-button" href="{{ path('app_livro_editar', {codigo: livro.codigo}) }}">Editar</a>
                                        <form method="post" action="{{ path('app_livro_excluir', {codigo: livro.codigo}) }}" onsubmit="return confirm('Excluir o livro {{ livro.titulo|e('js') }}?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('excluir_livro_' ~ livro.codigo) }}">
                                            <button class="link-button danger" type="submit">Excluir</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </section>
                {% endif %}
            </div>
        </section>
    </main>
{% endblock %}
