{% extends 'base.html.twig' %}

{% block title %}Livros | MyLibrary{% endblock %}

{% block body %}
    <main class="auth-portal app-portal authors-portal">
        <section class="app-shell authors-shell">
            <div class="app-welcome authors-welcome">
                <h1>Livros</h1>
            </div>

            <div class="app-content-panel authors-panel">
                <div class="app-content-panel__header authors-header-row">
                    <div class="app-panel-title-wrap">
                        <span class="auth-lock" aria-hidden="true">📖</span>
                        <div>
                            <h2>Gerenciamento de livros</h2>
                            <p>Gerencie o acervo e seus autores e assuntos.</p>
                        </div>
                    </div>
                    <a class="auth-submit app-submit" href="{{ path('app_livro_novo') }}">Novo livro</a>
                </div>

                {% for message in app.flashes('success') %}<div class="flash flash-success" role="status">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="flash flash-error" role="alert">{{ message }}</div>{% endfor %}

                {% if livros is empty %}
                    <section class="empty-state authors-empty">
                        <h3>Nenhum livro cadastrado</h3>
                        <p>Cadastre um livro para iniciar o acervo.</p>
                    </section>
                {% else %}
                    <section class="table-card authors-table-card table-scroll table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Título</th>
                                    <th>Autor(es)</th>
                                    <th>Assuntos</th>
                                    <th>Valor</th>
                                    <th class="actions-column">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for livro in livros %}
                                <tr>
                                    <td><a href="{{ path('app_livro_exibir', {codigo: livro.codigo}) }}">{{ livro.titulo }}</a></td>
                                    <td>{{ livro.autores|map(autor => autor.nome)|join(', ') }}</td>
                                    <td>{{ livro.assuntos|map(assunto => assunto.descricao)|join(', ') }}</td>
                                    <td>R$ {{ (livro.valor / 100)|number_format(2, ',', '.') }}</td>
                                    <td class="table-actions">
                                        <a class="link-button" href="{{ path('app_livro_editar', {codigo: livro.codigo}) }}"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil-line"><path d="M13 21h8"/><path d="m15 5 4 4"/><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/></svg></a>
                                        <form method="post" action="{{ path('app_livro_excluir', {codigo: livro.codigo}) }}" onsubmit="return confirm('Excluir o livro {{ livro.titulo|e('js') }}?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('excluir_livro_' ~ livro.codigo) }}">
                                            <button class="link-button danger" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </section>

                    {% if totalPages > 1 %}
                        <nav class="pagination" aria-label="Paginação de livros">
                            {% if page > 1 %}
                                <a class="pagination__link" href="{{ path('app_livro_index', {'page': page - 1}) }}">Anterior</a>
                            {% endif %}

                            <span class="pagination__status">Página {{ page }} de {{ totalPages }}</span>

                            {% if page < totalPages %}
                                <a class="pagination__link pagination__link--primary" href="{{ path('app_livro_index', {'page': page + 1}) }}">Próxima</a>
                            {% endif %}
                        </nav>
                    {% endif %}
                {% endif %}
            </div>
        </section>
    </main>
{% endblock %}
