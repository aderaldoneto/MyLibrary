{% extends 'base.html.twig' %}

{% block title %}Assuntos | MyLibrary{% endblock %}

{% block body %}
    <main class="auth-portal app-portal authors-portal">
        <section class="app-shell authors-shell">
            <div class="app-welcome authors-welcome">
                <h1>Assuntos</h1>
            </div>

            <div class="app-content-panel authors-panel">
                <div class="app-content-panel__header authors-header-row">
                    <div class="app-panel-title-wrap">
                        <span class="auth-lock" aria-hidden="true">📚</span>
                        <div>
                            <h2>Gerenciamento de assuntos</h2>
                            <p>Cadastre, edite e mantenha os assuntos do catálogo.</p>
                        </div>
                    </div>
                    <a class="auth-submit app-submit" href="{{ path('app_assunto_novo') }}">Novo assunto</a>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="flash flash-success" role="status">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="flash flash-error" role="alert">{{ message }}</div>
                {% endfor %}

                {% if assuntos is empty %}
                    <section class="empty-state authors-empty">
                        <h3>Nenhum assunto cadastrado</h3>
                        <p>Cadastre o primeiro assunto para organizar o acervo.</p>
                    </section>
                {% else %}
                    <section class="table-card authors-table-card table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Descrição</th>
                                    <th class="actions-column">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for assunto in assuntos %}
                                <tr>
                                    <td>{{ assunto.codigo }}</td>
                                    <td>{{ assunto.descricao }}</td>
                                    <td class="table-actions">
                                        <a class="link-button" href="{{ path('app_assunto_editar', {codigo: assunto.codigo}) }}"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil-line"><path d="M13 21h8"/><path d="m15 5 4 4"/><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/></svg></a>
                                        <form method="post" action="{{ path('app_assunto_excluir', {codigo: assunto.codigo}) }}" onsubmit="return confirm('Excluir o assunto {{ assunto.descricao|e('js') }}?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('excluir_assunto_' ~ assunto.codigo) }}">
                                            <button class="link-button danger" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </section>

                    {% if totalPages > 1 %}
                        <nav class="pagination" aria-label="Paginação de assuntos">
                            {% if page > 1 %}
                                <a class="pagination__link" href="{{ path('app_assunto_index', {'page': page - 1}) }}">Anterior</a>
                            {% endif %}

                            <span class="pagination__status">Página {{ page }} de {{ totalPages }}</span>

                            {% if page < totalPages %}
                                <a class="pagination__link pagination__link--primary" href="{{ path('app_assunto_index', {'page': page + 1}) }}">Próxima</a>
                            {% endif %}
                        </nav>
                    {% endif %}
                {% endif %}
            </div>
        </section>
    </main>
{% endblock %}
