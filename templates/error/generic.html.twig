{% extends 'base.html.twig' %}

{% block title %}Erro na aplicação | MyLibrary{% endblock %}

{% block body %}
    <main class="auth-portal app-portal">
        <section class="container py-5 text-center">
            <div class="error-card card border-0 shadow-sm mx-auto">
                <div class="card-body p-4 p-md-5">
                    <p class="error-code">{{ statusCode }}</p>
                    <h1 class="h3">Não foi possível concluir a solicitação</h1>
                    <p class="text-secondary mb-4">Tente novamente em instantes. Se o problema persistir, entre em contato com o suporte.</p>
                    <a class="btn btn-primary" href="{{ path('app_home') }}">Voltar para a home</a>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
