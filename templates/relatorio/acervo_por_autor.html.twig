{% extends 'base.html.twig' %}

{% block title %}Relatório do acervo por autor | MyLibrary{% endblock %}

{% block body %}
    <main class="auth-portal app-portal">
        <section class="app-shell container">
            <div class="app-content-panel card shadow-sm border-0">
                <div class="app-content-panel__header report-header">
                    <div class="app-panel-title-wrap">
                        <span class="auth-lock" aria-hidden="true">📊</span>
                        <div>
                            <h2>Relatório do acervo por autor</h2>
                            <p>Dados obtidos da view de relatório e agrupados por autor.</p>
                        </div>
                    </div>
                </div>

                <details class="report-filter" close>
                    <summary><span class="report-filter__toggle" aria-hidden="true"></span> Filtro</summary>
                    <form method="get" class="report-filter__form">
                        <div class="report-filter__grid">
                            <label>
                                Autor
                                <input type="text" name="autor" value="{{ filters.autor|default('') }}" placeholder="Nome do autor">
                            </label>
                            <label>
                                Editora
                                <input type="text" name="editora" value="{{ filters.editora|default('') }}" placeholder="Nome da editora">
                            </label>
                            <label>
                                Ano
                                <input type="text" name="ano" value="{{ filters.ano|default('') }}" placeholder="Ex.: 2024">
                            </label>
                        </div>

                        <div class="report-filter__actions">
                            <a class="report-filter__button report-filter__button--muted" href="{{ path('app_relatorio_acervo_por_autor') }}">Limpar</a>
                            <button class="report-filter__button report-filter__button--primary" type="submit">Aplicar</button>
                        </div>
                    </form>
                </details>

                {% if autores is empty %}
                    <div class="alert alert-info mb-0" role="status">Não há livros com autores para exibir no relatório.</div>
                {% else %}
                    {% for autor in autores %}
                        <section class="report-author mb-4">
                            <h3>{{ autor.nome }}</h3>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead><tr><th>Livro</th><th>Editora</th><th>Edição</th><th>Ano</th><th>Assuntos</th><th class="text-end">Valor</th></tr></thead>
                                    <tbody>
                                    {% for livro in autor.livros %}
                                        <tr>
                                            <td>{{ livro.titulo }}</td><td>{{ livro.editora }}</td><td>{{ livro.edicao }}</td><td>{{ livro.ano_publicacao }}</td>
                                            <td>{{ livro.assuntos ?: '—' }}</td><td class="text-end">R$ {{ (livro.valor / 100)|number_format(2, ',', '.') }}</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    {% endfor %}

                    <div class="report-summary" role="status">
                        <strong>{{ totalRegistros }}</strong> elemento(s) encontrado(s) no relatório.
                    </div>
                {% endif %}
            </div>
        </section>
    </main>
{% endblock %}
