{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
    <div style="max-width: 900px; margin: 60px auto; padding: 32px; font-family: Arial, sans-serif;">
        <div style="margin-bottom: 24px;">
            <h1 style="margin: 0;">Home</h1>
            <p style="margin: 8px 0 0; color: #475467;">Bem-vindo(a), {{ user.userName }} {{ user.userLastName }}</p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px;">
            <div style="padding: 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                <h2 style="margin-top: 0; font-size: 18px;">Acervo</h2>
                <p style="margin-bottom: 12px; color: #475467;">Gerencie os livros da biblioteca.</p>
                <a href="{{ path('app_livro_index') }}">Gerenciar livros</a>
            </div>
            <div style="padding: 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                <h2 style="margin-top: 0; font-size: 18px;">Autores</h2>
                <p style="margin-bottom: 12px; color: #475467;">Cadastre e mantenha os autores do acervo.</p>
                <a href="{{ path('app_autor_index') }}">Gerenciar autores</a>
            </div>
            <div style="padding: 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                <h2 style="margin-top: 0; font-size: 18px;">Assuntos</h2>
                <p style="margin-bottom: 12px; color: #475467;">Organize os assuntos do catálogo.</p>
                <a href="{{ path('app_assunto_index') }}">Gerenciar assuntos</a>
            </div>
            <div style="padding: 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                <h2 style="margin-top: 0; font-size: 18px;">Relatórios</h2>
                <p style="margin-bottom: 12px; color: #475467;">Acesse relatórios do acervo.</p>
            </div>
        </div>
    </div>
{% endblock %}
