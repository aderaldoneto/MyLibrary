{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
    <div style="max-width: 420px; margin: 80px auto; padding: 32px; border: 1px solid #dfe3e8; border-radius: 12px; font-family: Arial, sans-serif; background: #fff;">
        <h1 style="margin-bottom: 24px; text-align: center;">Login</h1>

        {% if error %}
            <div style="padding: 12px; margin-bottom: 16px; background: #fdecea; color: #b42318; border-radius: 8px;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post">
            <div style="margin-bottom: 16px;">
                <label for="username" style="display: block; margin-bottom: 8px; font-weight: 600;">E-mail</label>
                <input id="username" type="email" name="_username" value="{{ last_username }}" required autofocus style="width: 100%; padding: 10px 12px; border: 1px solid #c7ced6; border-radius: 8px; box-sizing: border-box;">
            </div>

            <div style="margin-bottom: 24px;">
                <label for="password" style="display: block; margin-bottom: 8px; font-weight: 600;">Senha</label>
                <input id="password" type="password" name="_password" required style="width: 100%; padding: 10px 12px; border: 1px solid #c7ced6; border-radius: 8px; box-sizing: border-box;">
            </div>

            <button type="submit" style="width: 100%; background: #1d4ed8; color: white; border: none; border-radius: 8px; padding: 12px; font-size: 16px; cursor: pointer;">
                Entrar
            </button>
        </form>
    </div>
{% endblock %}
